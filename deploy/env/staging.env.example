# LearnSense API environment — TEMPLATE. Placeholders only; never commit real values.
# Copy to deploy/env/staging.env (git-ignored by .gitignore rule `deploy/env/*.env`).
# Production uses the same keys, injected by the platform's secret manager.

# --- Environment (strict: startup fails if anything below is missing/unsafe) ---
LEARNSENSE_ENV=staging

# --- Supabase Auth (server-side token verification; publishable key only) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Never set a service_role key anywhere in LearnSense.

# --- PostgreSQL (required) ---
# In docker-compose staging the password matches deploy/env/staging_db_password.txt.
DATABASE_URL=postgresql://learnsense:<password>@db:5432/learnsense?sslmode=disable
LEARNSENSE_REQUIRE_PG=1
# PG_SSLMODE=require          # managed PostgreSQL / Supabase
# PG_MIN_SIZE=1
# PG_MAX_SIZE=5

# --- CORS: exact frontend origins, comma-separated (no '*') ---
ALLOWED_ORIGINS=http://localhost:8080

# --- LLM / VLM / OCR (owned by other workstreams; see .env.example) ---
LLM_PROVIDER=groq
LLM_MODE=live
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=<model-name>
VLM_MODE=disabled
OCR_LANGUAGES=eng+hin
