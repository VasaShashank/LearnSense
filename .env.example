# ============================================================================
# LearnSense / TAPROOT — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in real values.
# ALL keys in the REQUIRED sections must be set. The system will refuse to
# start (StartupPreflightError) if any required key is missing or blank.
# Nothing "falls back to mock" — mock adapters exist only inside the test
# harness and are unreachable from production.
# ============================================================================

# ---------- Server ----------
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- LLM (REQUIRED) ----------
# Provider: "groq" | "openai"
LLM_PROVIDER=groq
LLM_MODE=live
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Uncomment for OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ---------- VLM (REQUIRED when processing image-heavy PDFs) ----------
# Provider: "groq" | "openai"
VLM_PROVIDER=groq
VLM_MODEL=llama-4-scout-17b-16e-instruct
VLM_MODE=live
# Uses the same GROQ_API_KEY as LLM when provider=groq.
# Set VLM_API_KEY separately if using a different provider/account.
# VLM_API_KEY=

# ---------- OCR (REQUIRED when processing scanned PDFs) ----------
# Full path to the Tesseract binary. On Windows:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux / macOS:
# TESSERACT_CMD=/usr/bin/tesseract
# Comma-separated Tesseract language packs to verify at startup:
OCR_LANGUAGES=eng,hin

# ---------- Supabase Auth (REQUIRED for authenticated endpoints) ----------
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" anon key (safe for server-side use; do NOT use service-role key here)
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here
# Legacy alias — one of SUPABASE_PUBLISHABLE_KEY or SUPABASE_ANON_KEY is required
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---------- PostgreSQL / Supabase Database (institutional persistence) ----------
# Use the Supabase connection pooler for transaction-mode pooling (recommended):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or the direct connection (session-mode, port 5432):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres
# URI-encode reserved characters in the password (especially @) as %HH escapes.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# asyncpg SSL mode (default: require). Use disable only for trusted local PostgreSQL.
PG_SSLMODE=require

# Set to 1 in production to prevent silent fallback to JSON persistence:
LEARNSENSE_REQUIRE_PG=0

# Connection pool bounds (optional; defaults: min=1, max=5)
# PG_MIN_SIZE=1
# PG_MAX_SIZE=5
