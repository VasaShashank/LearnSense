# ============================================================================
# LearnSense / TAPROOT — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in real values.
# ALL keys in the REQUIRED sections must be set. The system will refuse to
# start (StartupPreflightError) if any required key is missing or blank.
# Nothing "falls back to mock" — mock adapters exist only inside the test
# harness and are unreachable from production.
# ============================================================================

# ---------- Server ----------
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- LLM (REQUIRED) ----------
# Provider: "groq" | "openai"
LLM_PROVIDER=groq
LLM_MODE=live
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Uncomment for OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ---------- VLM (REQUIRED when processing image-heavy PDFs) ----------
# Provider: "groq" | "openai"
VLM_PROVIDER=groq
VLM_MODEL=llama-4-scout-17b-16e-instruct
VLM_MODE=live
# Uses the same GROQ_API_KEY as LLM when provider=groq.
# Set VLM_API_KEY separately if using a different provider/account.
# VLM_API_KEY=

# ---------- OCR (REQUIRED when processing scanned PDFs) ----------
# Full path to the Tesseract binary. On Windows:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux / macOS:
# TESSERACT_CMD=/usr/bin/tesseract
# Comma-separated Tesseract language packs to verify at startup:
OCR_LANGUAGES=eng,hin