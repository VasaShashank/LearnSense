      "aliases": ["Frictional Force", "Force of Friction"],
      "type": "concept",
      "topic_id": "topic_friction",
      "description": "Resistive contact force acting parallel to surfaces in contact opposing relative motion."
    },
    {
      "concept_id": "c_static_friction",
