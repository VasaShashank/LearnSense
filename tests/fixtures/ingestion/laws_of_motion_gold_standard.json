  "gold_concepts": [
    {
      "concept_id": "c_newtons_first_law",
      "canonical_name": "Newton's First Law",
      "aliases": ["Newton's First Law of Motion", "First Law of Motion", "Law of Inertia", "First Law"],
      "type": "concept",
      "topic_id": "topic_newtons_laws",
      "description": "An object at rest remains at rest and an object in motion continues with constant velocity when no net force acts on it."
    },
    {
      "concept_id": "c_newtons_second_law",
      "canonical_name": "Newton's Second Law",
      "aliases": ["Newton's Second Law of Motion", "Second Law of Motion", "Second Law"],
      "type": "concept",
      "topic_id": "topic_newtons_laws",
      "description": "The net force on an object equals its inertial mass times acceleration (F = ma)."
    },
    {
      "concept_id": "c_newtons_third_law",
      "canonical_name": "Newton's Third Law",
      "aliases": ["Newton's Third Law of Motion", "Third Law of Motion", "Third Law"],
      "type": "concept",
      "topic_id": "topic_newtons_laws",
      "description": "For every action force exerted on a body, there is an equal and opposite reaction force on the other body."
    },
    {
      "concept_id": "c_inertial_mass",
      "canonical_name": "Inertial Mass",
      "aliases": ["Mass"],
      "type": "concept",
      "topic_id": "topic_newtons_laws",
      "description": "The property of a body that resists change in its state of motion."
    },
    {
      "concept_id": "c_net_force",
      "canonical_name": "Net Force",
      "aliases": ["Resultant Force", "Total Force"],
      "type": "concept",
      "topic_id": "topic_newtons_laws",
      "description": "The vector sum of all external forces acting on an object."
    },
    {
      "concept_id": "c_friction",
