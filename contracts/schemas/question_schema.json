{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://learnsense.example/contracts/v0.1/question.schema.json",
    "title": "LearnSense Question",
    "description": "Question metadata. Correct answers and scoring details must remain server-side and must not be exposed to student-facing clients.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "question_id",
        "question_type",
        "prompt",
        "assesses",
        "status"
    ],
    "properties": {
        "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
        },
        "question_type": {
            "enum": [
                "single_choice",
                "multiple_select",
                "numeric",
                "short_text",
                "structured_work",
                "other"
            ]
        },
        "prompt": {
            "type": "string",
            "minLength": 1
        },
        "options": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "option_id",
                    "text"
                ],
                "properties": {
                    "option_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "text": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "uniqueItems": false
        },
        "assesses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "concept_id",
                    "weight"
                ],
                "properties": {
                    "concept_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "weight": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                    },
                    "role": {
                        "enum": [
                            "primary",
                            "secondary",
                            "supporting"
                        ]
                    }
                }
            }
        },
        "difficulty": {
            "type": [
                "number",
                "null"
            ],
            "minimum": 0,
            "maximum": 1
        },
        "source_refs": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source_id"
                ],
                "properties": {
                    "source_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "locator": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            },
            "default": []
        },
        "status": {
            "enum": [
                "draft",
                "active",
                "deprecated"
            ]
        },
        "server_only": {
            "type": "object",
            "description": "Never send this object to a student-facing client.",
            "additionalProperties": false,
            "properties": {
                "answer_key": {},
                "rubric": {},
                "scoring_config": {
                    "type": "object"
                }
            }
        },
        "metadata": {
            "type": "object",
            "default": {}
        }
    }
}