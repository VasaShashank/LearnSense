{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnsense.example/contracts/v0.1/concept.schema.json",
  "title": "LearnSense Concept",
  "description": "Proposed canonical concept record. IDs must be stable and must not be derived from display names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept_id",
    "name",
    "description",
    "status"
  ],
  "properties": {
    "concept_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "chapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "prerequisite_concept_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true,
      "default": []
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  }
}