{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnsense.example/contracts/v0.1/tutoring_request.schema.json",
  "title": "LearnSense Tutoring Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "learner_id",
    "intent",
    "message",
    "created_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "learner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "intent": {
      "enum": [
        "explain_concept",
        "solve_with_guidance",
        "hint",
        "check_work",
        "review_mistake",
        "practice",
        "other"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true,
      "default": []
    },
    "question_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "preferred_depth": {
      "enum": [
        "brief",
        "standard",
        "detailed",
        "step_by_step"
      ],
      "default": "standard"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
