      },
      "canonical_laws": [
        {
          "id": "newton_second_law",
          "description": "Newton's Second Law of Motion",
          "patterns": [
            "F\\s*=\\s*m\\s*\\*?\\s*a",
            "(?:\\\\Sigma|Sigma)?\\s*F\\s*=\\s*m\\s*\\*?\\s*a",
            "F_net\\s*=\\s*m\\s*\\*?\\s*a"
          ]
        }
      ]
    }
  }
}