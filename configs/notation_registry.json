        "v0": "initial_velocity",
        "v": "final_velocity",
        "a": "acceleration",
        "t": "time",
        "\\Delta t": "time",
        "s": "displacement",
        "d": "displacement",
        "x": "displacement",
        "\\Delta x": "displacement"
      },
      "canonical_laws": [
        {
          "id": "kinematics_velocity_time",
          "description": "Velocity-Time Relation under Uniform Acceleration",
          "patterns": [
            "v\\s*=\\s*u\\s*\\+\\s*a\\s*\\*?\\s*t",
            "v\\s*=\\s*v_0\\s*\\+\\s*a\\s*\\*?\\s*t",
            "v\\s*=\\s*v0\\s*\\+\\s*a\\s*\\*?\\s*t",
            "v\\s*=\\s*v_0\\s*\\+\\s*a\\s*\\*?\\s*(?:\\\\Delta|Delta)?\\s*t",
            "v\\s*=\\s*v0\\s*\\+\\s*a\\s*\\*?\\s*(?:\\\\Delta|Delta)?\\s*t",
            "v\\s*=\\s*u\\s*\\+\\s*at"
          ]
        }
      ]
    },
    "calculus": {
      "aliases": {
        "dy/dx": "derivative",
        "f'(x)": "derivative",
        "\\frac{dy}{dx}": "derivative",
        "\\int": "integral"
      },
      "canonical_laws": [
        {
          "id": "derivative_power_rule",
          "description": "Power Rule for Derivatives",
          "patterns": [
            "d/dx\\s*\\[?x\\^n\\]?\\s*=\\s*n\\s*x\\^\\(n-1\\)",
            "\\(x\\^n\\)'\\s*=\\s*n\\s*x\\^\\(n-1\\)"
          ]
        }
      ]
    },
    "mechanics": {
      "aliases": {
        "F": "force",
