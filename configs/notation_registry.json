      },
      "canonical_laws": [
        {
          "id": "macro_gdp_expenditure",
          "description": "GDP Expenditure Formula",
          "patterns": [
            "Y\\s*=\\s*C\\s*\\+\\s*I\\s*\\+\\s*G\\s*\\+\\s*NX",
            "GDP\\s*=\\s*C\\s*\\+\\s*I\\s*\\+\\s*G\\s*\\+\\s*\\(?\\s*X\\s*-\\s*M\\s*\\)?"
          ]
        }
      ]
    },
    "computer_science": {
      "aliases": {
        "O(n)": "asymptotic_upper_bound",
        "Theta(n)": "asymptotic_tight_bound",
        "\\Theta(n)": "asymptotic_tight_bound",
        "BFS": "breadth_first_search",
        "DFS": "depth_first_search"
      },
      "canonical_laws": [
        {
          "id": "merge_sort_recurrence",
          "description": "Merge Sort Divide-and-Conquer Recurrence",
          "patterns": [
            "T\\(n\\)\\s*=\\s*2\\s*T\\(n/2\\)\\s*\\+\\s*O\\(n\\)",
            "T\\(n\\)\\s*=\\s*2\\s*T\\(n/2\\)\\s*\\+\\s*(?:\\\\Theta|Theta)\\s*\\(n\\)"
          ]
        }
      ]
    },
    "kinematics": {
      "aliases": {
